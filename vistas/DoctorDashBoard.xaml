<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="campusCare.vistas.DoctorDashBoard"
             Shell.NavBarIsVisible="False"
             Background="#242731"
             Title="DoctorDashBoard">
    <Grid ColumnDefinitions="Auto,*">
        <!-- Left Sidebar Menu -->
        <ScrollView Grid.Column="0" BackgroundColor="#282A36">
            <StackLayout Padding="20" Spacing="20" WidthRequest="200">
                <Image Source="logo_for_windows.png" HeightRequest="45" Margin="0,10,0,0"/>
                <Label Text="CAMPUS CARE" TextColor="White" FontAttributes="Bold" Margin="0,20,0,20" FontFamily="Bungee-Regular" FontSize="Subtitle" HorizontalOptions="Center" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="home.png" HeightRequest="20" WidthRequest="20" />
                    <Button Grid.Column="1" Text="Inicio" 
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start" FontFamily="Roboto-Black"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="cruz.png" HeightRequest="20" WidthRequest="20" />
                    <Button Grid.Column="1" Text="Citas Agendada"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start" FontFamily="Roboto-Black"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="notificaciones.png" HeightRequest="20" WidthRequest="20" />
                    <Button Grid.Column="1" Text="Recetas Agendadas"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start" FontFamily="Roboto-Black"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="perfil.png" HeightRequest="20" WidthRequest="20" />
                    <Button Grid.Column="1" Text="Pacientes"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start" FontFamily="Roboto-Black"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="medicamento.png" HeightRequest="20" WidthRequest="20" />
                    <Button Grid.Column="1" Text="Recetar Especialista"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start" FontFamily="Roboto-Black"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="notificaciones.png" HeightRequest="20" WidthRequest="20" />
                    <Button Grid.Column="1" Text="Aplicar Examen"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start" FontFamily="Roboto-Black"/>
                </Grid>
            </StackLayout>
        </ScrollView>

        <!-- Main Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Grid Grid.Row="0" Padding="20,10" ColumnDefinitions="*,Auto" BackgroundColor="#242731">
                <Label Grid.Column="0"
                       Text="Bienvenido Dr. Medina González"
                       TextColor="White"
                       VerticalOptions="Center"
                       FontSize="20" FontFamily="Roboto-Black"/>
                <Button Grid.Column="1"
                        Text="Perfil"
                        TextColor="White"
                        BackgroundColor="Transparent"/>
            </Grid>

            <!-- Metric Cards -->
            <Grid Grid.Row="1" Padding="20,20,20,10" ColumnDefinitions="*,*,*" ColumnSpacing="20">
                <Frame Grid.Column="0" BackgroundColor="#6B5ECD" Padding="20" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0">
                            <Label Text="25" TextColor="White" FontSize="24" HorizontalOptions="Start"/>
                            <Label Text="Citas agendadas" TextColor="White" HorizontalOptions="Start"/>
                        </StackLayout>
                        <Image Grid.Column="1" Source="cruz.png" HeightRequest="40" WidthRequest="40" VerticalOptions="Center"/>
                    </Grid>
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="#FF6B6B" Padding="20" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0">
                            <Label Text="25" TextColor="White" FontSize="24" HorizontalOptions="Start"/>
                            <Label Text="Total Pacientes" TextColor="White" HorizontalOptions="Start"/>
                        </StackLayout>
                        <Image Grid.Column="1" Source="perfil.png" HeightRequest="40" WidthRequest="40" VerticalOptions="Center"/>
                    </Grid>
                </Frame>
                <Frame Grid.Column="2" BackgroundColor="#4B9EFA" Padding="20" CornerRadius="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0">
                            <Label Text="25" TextColor="White" FontSize="24" HorizontalOptions="Start"/>
                            <Label Text="Recetas Asignadas" TextColor="White" HorizontalOptions="Start"/>
                        </StackLayout>
                        <Image Grid.Column="1" Source="medicamento.png" HeightRequest="40" WidthRequest="40" VerticalOptions="Center"/>
                    </Grid>
                </Frame>
            </Grid>

            <!-- Two-column layout below metric cards -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="20" Padding="20,10,20,20">
                <!-- Left Column -->
                <StackLayout Grid.Column="0">
                    <Label Text="Solicitudes de Cita" TextColor="White" FontSize="18" Margin="0,0,0,10"/>
                    <ScrollView>
                        <StackLayout BackgroundColor="#282A36" >
                            <Frame BackgroundColor="#282A36" Margin="0,0,0,10" Padding="10" CornerRadius="5" BorderColor="Transparent">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackLayout Grid.Column="0">
                                        <Label Text="Verónica Aguilar" TextColor="White" FontSize="16"/>
                                        <Label Text="23 de agosto 2024" TextColor="Gray" FontSize="12"/>
                                        
                                    </StackLayout>
                                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        
                                        <Button Text="Aceptar" 
                                                BackgroundColor="#373367"
                                                TextColor="#6D63E5"
                                                FontFamily="Ubuntu"
                                                FontSize="12"                                           
                                                Padding="5,0,5,0"/>
                                        
                                        <Button Text="Rechazar"
                                                FontFamily="Ubuntu"
                                                BackgroundColor="#BA414D"
                                                TextColor="#FF5263"
                                                FontSize="12"
                                                Padding="5,0,5,0"/>
                                    </StackLayout>
                                </Grid>
                            </Frame>
                            <Frame BackgroundColor="#282A36" Margin="0,0,0,10" Padding="10" CornerRadius="5" BorderColor="Transparent">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackLayout Grid.Column="0">
                                        <Label Text="Juan Pérez" TextColor="White" FontSize="16"/>
                                        <Label Text="24 de agosto 2024" TextColor="Gray" FontSize="12"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <Button Text="Aceptar" 
                                                BackgroundColor="#6B5ECD"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="5,2"/>
                                        <Button Text="Rechazar"
                                                BackgroundColor="#FF6B6B"
                                                TextColor="White"
                                                FontSize="12"
                                                Padding="5,2"/>
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </StackLayout>
                    </ScrollView>
                </StackLayout>

                <!-- Right Column -->
                <StackLayout Grid.Column="1">
                    <Label Text="Chequeos de Pacientes" TextColor="White" FontSize="18" Margin="0,0,0,10"/>
                    <ScrollView>
                        <StackLayout>
                            <Frame BackgroundColor="#242731" Margin="0,0,0,10" Padding="10" CornerRadius="5">
                                <StackLayout>
                                    <Label Text="Verónica Aguilar" TextColor="White" FontSize="16"/>
                                    <Label Text="23 de agosto 2024" TextColor="Gray" FontSize="12"/>
                                </StackLayout>
                            </Frame>
                            <Frame BackgroundColor="#242731" Margin="0,0,0,10" Padding="10" CornerRadius="5">
                                <StackLayout>
                                    <Label Text="Juan Pérez" TextColor="White" FontSize="16"/>
                                    <Label Text="24 de agosto 2024" TextColor="Gray" FontSize="12"/>
                                </StackLayout>
                            </Frame>
                            <Frame BackgroundColor="#242731" Margin="0,0,0,10" Padding="10" CornerRadius="5">
                                <StackLayout>
                                    <Label Text="María López" TextColor="White" FontSize="16"/>
                                    <Label Text="25 de agosto 2024" TextColor="Gray" FontSize="12"/>
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </ScrollView>
                </StackLayout>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>