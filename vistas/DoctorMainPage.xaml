<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="campusCare.vistas.DoctorMainPage"
             Title="DoctorMainPage">
    <Grid Margin="50,0,50,0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackLayout Grid.Row="0" Spacing="10">

            <Button Text="Ver donantes de Sangre" Clicked="DonarSangre"/>
            <Button Text="Crear Receta" Clicked="Receta"/>
            <Button Text="Ver Citas agendadas" Clicked="citas"/>
            <Button Text="Ver Medicamentos" Clicked="Medicamentos" />
            

        </StackLayout>

        <Button Text="Cerrar Sesión" Grid.Row="1" Command="{Binding logOutCommand}"/>
    </Grid>
   
</ContentPage>