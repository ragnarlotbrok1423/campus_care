<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="campusCare.vistas.RecetasView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    Title="RecetasView"
    BackgroundColor="White"
    Shell.NavBarIsVisible="false">
    <Grid>

        <!--  Version para windows  -->
        <Grid IsVisible="{OnPlatform Android=false, WinUI=true}">

            <ScrollView Orientation="Both">
                <material:DataGrid
                    Margin="30"
                    BackgroundColor="#136AED"
                    HorizontalOptions="Center"
                    ItemsSource="{Binding Recetas}">

                    <material:DataGrid.Columns>

                        <material:DataGridColumn Title="Fecha de Entrega" ValueBinding="{Binding FechaDeEntrega}" />
                        <material:DataGridColumn Title="CantidadDeEntrega" ValueBinding="{Binding CantidadDeEntrega}" />
                        <material:DataGridColumn Title="Medicamento" ValueBinding="{Binding Medicamento.Nombre}" />
                        <material:DataGridColumn Title="Observaciones" ValueBinding="{Binding Observaciones}" />
                        <material:DataGridColumn Title="Nombre Paciente" ValueBinding="{Binding Paciente.Nombre}" />

                        <material:DataGridColumn Title="Cedula Paciente" ValueBinding="{Binding Paciente.Cedula}" />
                        <material:DataGridColumn Title="Nombre Doctor" ValueBinding="{Binding Doctor.NombreCompleto}" />
                        <material:DataGridColumn Title="Cedula Doctor" ValueBinding="{Binding Doctor.Cedula}" />

                    </material:DataGrid.Columns>

                </material:DataGrid>

            </ScrollView>



        </Grid>

        <!--  Version para android  -->
        <Grid IsVisible="{OnPlatform Android=true, WinUI=false}" />
    </Grid>
</ContentPage>